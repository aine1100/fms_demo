# API gateway port
API_GATEWAY_PORT=4000

# Service ports
AUTH_PORT=4001
CUSTOMER_PORT=4002
EXTINGUISHER_PORT=4003
NOTIFICATION_PORT=4004
PAYMENT_PORT=4005
INSPECTION_PORT=4006
RULES_PORT=4007

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/fms_db

# JWT / Authentication
JWT_SECRET=your_jwt_secret
JWT_EXPIRES_IN=24h
JWT_REFRESH_EXPIRES_IN=7d

# SMTP / Email
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_smtp_user
SMTP_PASS=your_smtp_password
SMTP_FROM=no-reply@example.com

# Redis (optional)
REDIS_URL=redis://127.0.0.1:7001
REDIS_PORT=7001

# Next.js frontend service URLs
NEXT_PUBLIC_AUTH_SERVICE_URL=http://localhost:4001
NEXT_PUBLIC_CUSTOMER_SERVICE_URL=http://localhost:4002
NEXT_PUBLIC_EXTINGUISHER_SERVICE_URL=http://localhost:4003
NEXT_PUBLIC_NOTIFICATION_SERVICE_URL=http://localhost:4004
NEXT_PUBLIC_PAYMENT_SERVICE_URL=http://localhost:4005
NEXT_PUBLIC_INSPECTION_SERVICE_URL=http://localhost:4006
NEXT_PUBLIC_RULES_SERVICE_URL=http://localhost:4007
